PORT=5001
NODE_ENV=development
DB_TYPE=better-sqlite3
DB_SQLITE_PATH=./lms_tuition.db
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
# Optional MySQL settings (when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tuition_lms
JWT_SECRET=change_me_in_production_min_32_chars_long
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5174,http://localhost:3006,http://localhost:4174
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
APP_TIMEZONE=Asia/Colombo

